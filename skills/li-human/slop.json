  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\" (no es solo X, es Y; en inglés)",
      "fix": "Di lo único que de verdad quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\" (no solo X sino también Y; en inglés)",
      "fix": "Divídela en dos oraciones, o quita la mitad más débil."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\" (no se trata de X, se trata de Y; en inglés)",
      "fix": "Empieza por Y. El giro es lo que delata."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "Línea con una pregunta retórica de una palabra (en inglés)",
      "fix": "Respóndela en la misma línea en lugar de montar una revelación."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\" (esto es lo que aprendí; en inglés)",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Tríada de tres elementos (en inglés)",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / foco / destellos / diana",
      "fix": "Un emoji como máximo, y que no sea uno de estos cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5 o más)",
      "fix": "Tres hashtags. LinkedIn dejó de premiar el muro."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "El modelo hablando de sí mismo (en inglés)",
      "fix": "Borra la oración."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Apertura de conclusión de ensayo (en inglés)",
      "fix": "Un post no necesita un párrafo de conclusión."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Cebo de interacción reflejo (en inglés)",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo específico que dijiste arriba."
    },
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno (?:es|son) (?:solo|sólo|solamente|simplemente|únicamente) [^.!?\\n]{2,60}?[,.;]\\s*(?:es|son|sino)\\b(?!\\s+(?:también|además)\\b)",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di lo único que de verdad quieres decir. Borra la mitad que prepara.",
      "lang": "es"
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:(?:es|son) )?(?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|además)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Divídela en dos oraciones, o quita la mitad más débil.",
      "lang": "es"
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata (?:solo |sólo )?de [^.!?\\n]{2,60}[,.;]\\s*(?:se trata de|sino de)\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y. El giro es lo que delata.",
      "lang": "es"
    },
    {
      "id": "el-resultado",
      "regex": "(?i)^\\s*¿?(?:el resultado|lo mejor|lo peor|la clave|el truco|la trampa|lo curioso|el problema|la sorpresa|por qué)\\?\\s*$",
      "name": "Línea con una pregunta retórica suelta (¿El resultado?)",
      "fix": "Respóndela en la misma línea en lugar de montar una revelación.",
      "lang": "es"
    },
    {
      "id": "esto-aprendi",
      "regex": "(?i)\\b(?:esto es|aquí va|aquí está|te cuento|les cuento) lo que (?:aprendí|aprendimos|descubrí)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di la lección. Sáltate el anuncio.",
      "lang": "es"
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+,? (?:y|e) \\w+\\.",
      "name": "Tríada de tres elementos",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo.",
      "lang": "es"
    },
    {
      "id": "cohete",
